# Copy this file to .env and change what you need. Every name starts with VPI_ (see shared/settings.py).
# .env is private: never share it or commit it (it can hold your OpenRouter key).

VPI_PROFILE=local
VPI_ENCODER=color_hist            # color_hist (no download) | dinov2_small | siglip2_base
VPI_DETECTOR=none                 # none | owlv2
VPI_RERANKER=none                 # none | openrouter:google/gemma-4-31b-it:free | local:<hf id> (Colab)
VPI_STRONG_RERANKER=              # optional: used only on close calls, never in strict budget mode
VPI_ABSTAIN_THRESHOLD=0.0         # set from: python tasks.py calibrate
VPI_OPENROUTER_API_KEY=
# VPI_SPEND_PCT=85                # replay "85% of budget spent" to watch strict mode, without spending

# ---- colab profile (the same code, bigger models) ----
# VPI_PROFILE=colab
# VPI_ENCODER=siglip2_so400m
# VPI_DETECTOR=owlv2
# VPI_DATA_DIR=/content/data/stanford_cars
